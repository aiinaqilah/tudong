flowchart TB
    subgraph Client["Client Tier — Browser"]
        UI["Next.js + React UI<br/>(Server & Client Components)"]
        Z["Zustand cart state"]
    end

    subgraph App["Application Tier — Vercel"]
        Next["Next.js Server<br/>(Server Actions / API Routes)"]
        Auth["Better Auth<br/>RBAC: user / seller / admin"]
    end

