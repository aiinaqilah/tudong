erDiagram
    USER ||--o{ SESSION : has
    USER ||--o{ ACCOUNT : authenticates
    USER ||--o| CART : owns
    USER ||--o{ FAVORITE : saves
    USER ||--o| SELLER_APPLICATION : submits
    CART ||--o{ CART_LINE_ITEM : contains
    USER ||--o{ PRODUCT : "sells (sellerId)"
    USER ||--o{ ORDER : "places (customerId)"
    PRODUCT_CATEGORY ||--o{ PRODUCT : categorises
    BRAND ||--o{ PRODUCT : brands
    MATERIAL ||--o{ PRODUCT : "made of"
    COLLECTION ||--o{ PRODUCT : groups
    PRODUCT }o--o{ SIZE : "available in"
    ORDER ||--o{ ORDER_ITEM : contains
    PRODUCT ||--o{ ORDER_ITEM : "ordered as"
    PRODUCT ||--o{ CART_LINE_ITEM : "referenced by"
    PRODUCT ||--o{ FAVORITE : "favourited as"
    PROMOTION_CAMPAIGN }o--o{ PRODUCT : discounts

    USER {
        string id PK
        string email UK
        string name
        string role "user | seller | admin"
        boolean emailVerified
        datetime createdAt
    }
    ACCOUNT {
        string id PK
        string userId FK
        string providerId
        string password "hashed"
    }
    SESSION {
        string id PK
        string userId FK
        string token UK
        datetime expiresAt
    }
    SELLER_APPLICATION {
        string id PK
        string userId FK
        string brandName
        string status "PENDING | APPROVED | REJECTED"
    }
    CART {
        string id PK
        string userId FK
        datetime createdAt
    }
    CART_LINE_ITEM {
        string id PK
        string cartId FK
        string sanityProductId
        int quantity
        float price
    }
    FAVORITE {
        string id PK
        string userId FK
        string productId
        datetime createdAt
    }
    PRODUCT {
        string _id PK
        string title
        float price
        int stock
        boolean inStock
        int discount
        string sellerId
        array color
        datetime _createdAt
    }
    PRODUCT_CATEGORY {
        string _id PK
        string title
        slug slug
    }
    BRAND {
        string _id PK
        string name
        string sellerId
    }
    MATERIAL {
        string _id PK
        string name
    }
    SIZE {
        string _id PK
        string name
    }
    COLLECTION {
        string _id PK
        string title
        string sellerId
    }
    ORDER {
        string _id PK
        string orderNumber
        string customerId
        float totalPrice
        string status "PROCESSING | SHIPPED | DELIVERED | CANCELLED"
        datetime orderDate
    }
    ORDER_ITEM {
        string productRef FK
        int quantity
        float price
    }
    PROMOTION_CAMPAIGN {
        string _id PK
        string title
        string discountType
        number discountValue
        boolean isActive
    }
    PROMOTION_CODE {
        string _id PK
        string code
        string discountType
        number discountValue
        datetime expiresAt
    }
